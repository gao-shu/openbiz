<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.openbiz.biz.mapper.OpenbizOrderItemMapper">
    <resultMap id="OI" type="com.openbiz.biz.domain.OpenbizOrderItem">
        <id property="id" column="id"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="orderId" column="order_id"/>
        <result property="itemId" column="item_id"/>
        <result property="quantity" column="quantity"/>
        <result property="unitPrice" column="unit_price"/>
        <result property="amount" column="amount"/>
    </resultMap>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO openbiz_order_item (tenant_id, order_id, item_id, quantity, unit_price, amount)
        VALUES (#{tenantId}, #{orderId}, #{itemId}, #{quantity}, #{unitPrice}, #{amount})
    </insert>
    <select id="listByOrderAndTenant" resultMap="OI">
        SELECT id, tenant_id, order_id, item_id, quantity, unit_price, amount
        FROM openbiz_order_item WHERE order_id = #{orderId} AND tenant_id = #{tenantId}
    </select>
</mapper>
