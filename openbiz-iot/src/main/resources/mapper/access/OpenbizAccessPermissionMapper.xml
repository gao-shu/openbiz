<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.openbiz.access.mapper.OpenbizAccessPermissionMapper">

    <resultMap id="PermResult" type="com.openbiz.access.domain.OpenbizAccessPermission">
        <id property="id" column="id"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="userId" column="user_id"/>
        <result property="deviceId" column="device_id"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <select id="selectActive" resultMap="PermResult">
        SELECT id, tenant_id, user_id, device_id, status, create_time, update_time
        FROM openbiz_access_permission
        WHERE tenant_id = #{tenantId}
          AND user_id = #{userId}
          AND device_id = #{deviceId}
          AND status = '0'
        LIMIT 1
    </select>

</mapper>
