<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.openbiz.charging.mapper.OpenbizChargingConnectorMapper">

    <resultMap id="ConnectorResult" type="com.openbiz.charging.domain.OpenbizChargingConnector">
        <id     property="id"          column="id"/>
        <result property="tenantId"    column="tenant_id"/>
        <result property="stationId"   column="station_id"/>
        <result property="connectorNo" column="connector_no"/>
        <result property="status"      column="status"/>
        <result property="createTime"  column="create_time"/>
        <result property="updateTime"  column="update_time"/>
    </resultMap>

    <select id="selectByIdAndTenant" resultMap="ConnectorResult">
        SELECT id, tenant_id, station_id, connector_no, status, create_time, update_time
        FROM openbiz_charging_connector
        WHERE id = #{id} AND tenant_id = #{tenantId}
        LIMIT 1
    </select>

    <update id="updateStatus">
        UPDATE openbiz_charging_connector
        SET status = #{status}, update_time = NOW()
        WHERE id = #{id} AND tenant_id = #{tenantId}
    </update>

</mapper>
