<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.openbiz.saas.mapper.OpenbizTenantMapper">

    <resultMap id="OpenbizTenantResult" type="com.openbiz.saas.domain.OpenbizTenant">
        <id     property="id"         column="id" />
        <result property="tenantCode" column="tenant_code" />
        <result property="tenantName" column="tenant_name" />
        <result property="status"     column="status" />
        <result property="createTime" column="create_time" />
        <result property="updateTime" column="update_time" />
    </resultMap>

    <select id="selectById" resultMap="OpenbizTenantResult">
        SELECT id, tenant_code, tenant_name, status, create_time, update_time
        FROM openbiz_tenant
        WHERE id = #{id}
    </select>

    <select id="selectByCode" resultMap="OpenbizTenantResult">
        SELECT id, tenant_code, tenant_name, status, create_time, update_time
        FROM openbiz_tenant
        WHERE tenant_code = #{tenantCode}
    </select>

</mapper>
